---
import Layout from '../layouts/Layout.astro';import Picture from '../components/Picture.astro';import groups from '../data/playground.json';
---
<Layout title="Playground — Jayden Park" description="Social graphics and visual storytelling for KUSA, VAPS, Youth in Policy, and Lambda Phi Epsilon."><div class="wrap"><header class="page-head"><p class="eyebrow">A space to make, share & experiment</p><h1>Made for<br/><em>the moment.</em></h1><p>Visuals for the communities I’m part of. A playground of social graphics, shared stories, and creative experiments.</p><nav class="collection-nav" aria-label="Jump to social collection">{groups.map(g=><a href={`#${g.id}`}>{g.title}</a>)}</nav></header>{groups.map(g=><section class="social-group" id={g.id}><div class="section-heading"><div><p class="eyebrow">Social & community</p><h2>{g.title}</h2></div><div><p>{g.role}</p><a class="text-link" href={g.url}>Visit the community ↗</a></div></div><div class="social-grid">{g.images.map((im,i)=><figure><button class="zoom-button" data-zoom data-caption={`${g.title} — graphic collection ${i+1}`} aria-label={`Enlarge ${g.title} graphic collection ${i+1}`}><Picture image={im} alt={`${g.title} social graphics, collection ${i+1}`} sizes="(max-width:700px) 45vw, 30vw"/></button><figcaption>{g.title} / {String(i+1).padStart(2,'0')}</figcaption></figure>)}</div></section>)}</div></Layout>
