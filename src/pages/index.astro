---
import Layout from '../layouts/Layout.astro';import Picture from '../components/Picture.astro';import Card from '../components/Card.astro';import projects from '../data/projects.json';import groups from '../data/playground.json';
const get=(slug:string)=>projects.find(p=>p.slug===slug)!;
const featured=['the-upside-downtown','change-miracle-flights','textures','voyage','change-design-challenge','drift'].map(get);
const more=projects.filter(p=>!featured.includes(p));
---
<Layout><section class="hero wrap"><div class="hero-copy"><p class="eyebrow"><span class="tiny-star" aria-hidden="true">✳</span> A curious mind. A creative practice.</p><h1>Ideas, with<br/><em>a life of<br class="desktop-break"/> their own.</em></h1><p class="hero-description">Hi, I’m <strong>Jayden Park.</strong> I make art, design digital experiences, and turn ideas into visuals that connect with people.</p><a class="text-link" href="#work">Step into my world <span aria-hidden="true">↓</span></a></div><div class="collage" aria-label="A movable collage of Jayden’s work"><span class="collage-orbit" aria-hidden="true"></span><span class="collage-note">a few things<br/>from my imagination</span>{[get('the-upside-downtown'),get('textures'),get('change-miracle-flights')].map((p,i)=><div class={`collage-piece piece-${i}`} tabindex="0" role="group" aria-label={`${p.title}. Use arrow keys to move; Escape to reset.`}><Picture image={p.images[0]} alt={p.title} eager sizes="(max-width:700px) 70vw, 35vw"/><span>{i===0?'01 / imagination':i===1?'02 / observation':'03 / connection'}</span></div>)}<div class="collage-caption"><span>Art + design + a little play</span><button data-reset aria-label="Reset collage positions">Reset ↺</button></div></div></section>
<section class="intro-strip wrap" aria-label="Background"><p>Creative by instinct.<br/><strong>People-minded by practice.</strong></p><div><span class="eyebrow">Currently</span><p>Vanderbilt University<br/>Human & Organizational Development,<br/>Business, and Art</p></div><div><span class="eyebrow">Across my work</span><p>Fine art · Visual design<br/>Digital experiences · Marketing</p></div><a href="/about/" class="circle-link" aria-label="More about Jayden">↗</a></section>
<section class="work-section wrap" id="work"><div class="section-heading"><div><p class="eyebrow">01 / A selection</p><h2>Different forms.<br/><em>Same curiosity.</em></h2></div><p>From pencil on paper to pixels on a screen.<br/>A collection of things I’ve imagined,<br/>explored, and brought into the world.</p></div><div class="featured-grid">{featured.map((project,i)=><div class:list={['featured-item',`item-${i}`]} data-reveal><Card project={project} featured/></div>)}</div></section>
<section class="archive-section wrap"><div class="section-heading compact"><div><p class="eyebrow">02 / Keep exploring</p><h2>There’s <em>more.</em></h2></div><div class="filters" aria-label="Filter more projects"><button data-filter="all" aria-pressed="true">All</button><button data-filter="design" aria-pressed="false">Design</button><button data-filter="art" aria-pressed="false">Fine art</button></div></div><p class="sr-only" aria-live="polite" data-filter-status></p><div class="archive-grid">{more.map(project=><div data-kind={project.kind}><Card project={project}/></div>)}</div></section>
<section class="play-preview"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">03 / Out in the world</p><h2>A serious<br/>sense of <em>play.</em></h2></div><div><p>Social graphics, campus communities,<br/>and ideas made to be shared.</p><a class="text-link" href="/playground/">Enter the playground ↗</a></div></div><div class="play-preview-grid">{groups.slice(0,3).map(g=><a href={`/playground/#${g.id}`}><Picture image={g.images[0]} alt={`${g.title} social graphics`}/><span>{g.title} ↗</span></a>)}</div></div></section>
<section class="about-teaser wrap"><span class="big-star" aria-hidden="true">✳</span><div><p class="eyebrow">The person behind the pixels</p><h2>Artist. Designer.<br/><em>Always figuring things out.</em></h2><a class="text-link" href="/about/">A little more about me ↗</a></div></section></Layout>
