---
import Layout from '../layouts/Layout.astro';import Experience from '../components/Experience.astro';import Picture from '../components/Picture.astro';import FragmentGallery from '../components/FragmentGallery.astro';import projects from '../data/projects.json';
const get=(slug:string)=>projects.find(p=>p.slug===slug)!;
const fineArtPaths=projects.filter(p=>p.category==='Fine art').map(p=>`/work/${p.slug}/`);
---
<Layout><section class="hero wrap"><div class="hero-copy"><h1><span><span class="sr-only">hi,</span><span aria-hidden="true">h<span class="star-i">ı<span class="i-star">✳</span></span>,</span></span><span>I’m <a class="hero-name" href="/about/">Jayden</a></span></h1><p class="hero-description">I work across art, design, and strategy to make complex ideas clear, useful, and <strong>memorable</strong>.</p><a class="text-link" href="#work">Follow the thread <span aria-hidden="true">↓</span></a></div><div class="collage" aria-label="Selected work"><div class="collage-heading"><span>FEATURED: FRAGMENTS OF THE DAY / 01—03</span><span aria-hidden="true">[ JP ]</span></div>{[get('the-upside-downtown'),get('textures'),get('drift')].map((p,i)=><a class={`collage-piece piece-${i}`} href={`/work/${p.slug}/`} aria-label={`Explore ${p.title}`}><Picture image={i===0 ? {file:"183f58_26b25dce1a5f4730950c4d074159297b~mv2.jpg"} : p.images[0]} alt={p.title} eager sizes="(max-width:700px) 75vw, 38vw"/><span><b>{String(i+1).padStart(2,'0')}</b> {p.title}<span aria-hidden="true">↗</span></span></a>)}<div class="collage-caption"><a class="random-fragment" href={fineArtPaths[0]} data-random-fragment={JSON.stringify(fineArtPaths)} aria-label="Open a random fine-art fragment">Open a fragment <span aria-hidden="true">↗</span></a></div></div></section>
<section class="intro-strip wrap" aria-label="Background"><div class="current-background"><span class="eyebrow">Currently</span><p>Campus Growth Lead @ Partiful</p><p class="current-studies">Studying Human &amp; Organizational Development, Art, Business<br/>@ Vanderbilt University (c/o 2027!)</p></div><div class="previous-background"><span class="eyebrow">Previously</span><p>@ TikTok<br/>@ L’Oréal<br/>@ Pepper</p></div><div class="focus-background"><span class="eyebrow">Focuses</span><p><span class="focus-line">Growth Marketing · Product Marketing · UI Design</span><span class="focus-line">Visual &amp; Digital Design · Public Relations</span></p></div><a href="/about/" class="circle-link" aria-label="More about Jayden">↗</a></section>
<Experience/><FragmentGallery/>
</Layout>
