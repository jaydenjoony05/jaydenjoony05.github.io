---
import Layout from '../../layouts/Layout.astro';import Picture from '../../components/Picture.astro';import projects from '../../data/projects.json';
export function getStaticPaths(){return projects.map((project,index)=>({params:{slug:project.slug},props:{project,next:projects[(index+1)%projects.length]}}));}
const {project:p,next}=Astro.props;const miracle=p.slug==='change-miracle-flights';
---
<Layout title={`${p.title} — Jayden Park`} description={p.description||`${p.title}, a ${p.category.toLowerCase()} project by Jayden Park.`}><article class="wrap page-head project-body"><a class="back-link" href="/#work">← Back to work</a><div class="project-head"><p class="eyebrow">{p.category}</p><h1>{p.title}</h1><p class="project-description">{p.description}</p></div>{miracle&&<dl class="meta-row"><div><dt>Discipline</dt><dd>Website UI design</dd></div><div><dt>Engagement</dt><dd>6 months</dd></div><div><dt>Organization</dt><dd>Miracle Flights · Nonprofit</dd></div></dl>}
{p.images.map((im,i)=><><figure class="project-figure"><button class="zoom-button" data-zoom data-caption={im.alt?im.alt.replace(/\.(png|jpg)$/i,''):`${p.title} — view ${i+1}`} aria-label={`Enlarge ${p.title}, view ${i+1}`}><Picture image={im} alt={im.alt?`${p.title}: ${im.alt.replace(/\.(png|jpg)$/i,'')}`:`${p.title}, ${p.category.toLowerCase()}, view ${i+1}`} eager={i===0} sizes="90vw"/><span class="zoom-label" aria-hidden="true">View detail ↗</span></button>{im.alt&&<figcaption>{im.alt.replace(/\.(png|jpg)$/i,'')}</figcaption>}</figure>{miracle&&i===0&&<section class="project-context"><div><p class="eyebrow">The context</p><h2>Helping care<br/><em>feel closer.</em></h2></div><div><p>Miracle Flights provides free flights for people who need life-changing medical care outside their local communities. This six-month project focused on website interface design.</p><p>The screens below span the landing page, notifications, patient and companion information, trips, flight requests, and document uploads. Together, they show the range of the interface work.</p></div></section>}</>)}
<a class="next-project" href={`/work/${next.slug}/`}><span><span class="eyebrow">Next in the collection</span><br/><strong>{next.title}</strong></span><span aria-hidden="true">↗</span></a></article></Layout>
