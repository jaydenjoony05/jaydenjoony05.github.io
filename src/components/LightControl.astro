<label class="light-control" title="Adjust studio lighting">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="3.5"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
  <span>Light</span>
  <input type="range" min="0" max="100" value="50" step="1" aria-orientation="vertical" aria-label="Studio shadow intensity" aria-valuetext="50 percent"/>
</label>
<style>
.light-control{position:absolute;left:-29px;top:min(50%,50svh);transform:translateY(-50%) scale(.95);z-index:8;display:flex;flex-direction:column;align-items:center;gap:7px;width:28px;color:#737373;--level:50%;}
svg{width:14px;height:14px;flex:none}
span{font:8px var(--mono);letter-spacing:.06em;text-transform:uppercase}
input{appearance:none;-webkit-appearance:none;writing-mode:vertical-lr;direction:rtl;width:28px;height:72px;margin:0;background:transparent;cursor:ns-resize}
input::-webkit-slider-runnable-track{width:2px;background:linear-gradient(to top,#737373 var(--level),#dedede var(--level));border-radius:2px}
input::-moz-range-track{width:2px;background:#dedede;border-radius:2px}
input::-moz-range-progress{width:2px;background:#737373}
input::-webkit-slider-thumb{appearance:none;width:9px;height:9px;margin-left:-3.5px;border:0;border-radius:50%;background:#737373;box-shadow:0 0 0 1px #00000020}
input::-moz-range-thumb{width:9px;height:9px;border:0;border-radius:50%;background:#737373;box-shadow:0 0 0 1px #00000020}
input:focus-visible{outline:2px solid #737373;outline-offset:3px;border-radius:3px}
@media(max-width:700px){.light-control{left:-23px;width:24px}input{width:24px;height:60px}}
</style>
