---
<section class="personal-play" aria-label="A few personal favorites">
  <div class="personal-play-intro"><p class="eyebrow">A few things that make me, me.</p><button class="personal-remix" type="button">Remix the little things <span aria-hidden="true">↻</span></button></div>
  <div class="personal-play-groups">
    {groups.map(group => <div class="personal-play-group"><h3><span>{group.number} /</span>{group.title}</h3><ul>{group.items.map((item, index) => <li hidden={index >= 3}><button type="button" class="personal-token" data-motion={item.motion} aria-label={`Animate ${item.label}`}><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={item.icon}/><span>{item.label}</span><i aria-hidden="true">✳</i></button></li>)}</ul></div>)}
  </div>
  <p class="personal-play-hint">Three little things from each category. Tap Remix for a fresh mix.</p>
  <span class="sr-only personal-remix-status" role="status"></span>
</section>
<script>
  import { aboutPhotosFinished } from '../scripts/about-motion';
  const play = document.querySelector('.personal-play');
  const remixButton = play?.querySelector<HTMLButtonElement>('.personal-remix');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let entranceObserver: IntersectionObserver | undefined;
  let entranceRun = 0;
  function cueRemix() {
    const run = ++entranceRun;
    entranceObserver?.disconnect();
    if (!remixButton || reducedMotion.matches) return;
    entranceObserver = new IntersectionObserver(async entries => {
      if (!entries.some(entry => entry.isIntersecting)) return;
      entranceObserver?.disconnect();
      await aboutPhotosFinished;
      await new Promise(resolve => setTimeout(resolve, 700));
      if (run !== entranceRun || reducedMotion.matches) return;
      const bounds = remixButton.getBoundingClientRect();
      if (bounds.bottom <= 0 || bounds.top >= window.innerHeight) {
        entranceObserver?.observe(remixButton);
        return;
      }
      // Space the original shake beats 1 / 0.7 times farther apart (30% slower).
      const shakeBeat = 100 / 0.7;
      const duration = 800;
      remixButton.animate([
        { transform: 'scale(1) rotate(0deg)', offset: 0 },
        { transform: 'scale(1.32) rotate(-4deg)', offset: shakeBeat / duration },
        { transform: 'scale(1.32) rotate(4deg)', offset: 2 * shakeBeat / duration },
        { transform: 'scale(1.32) rotate(-3deg)', offset: 3 * shakeBeat / duration },
        { transform: 'scale(1.32) rotate(3deg)', offset: 4 * shakeBeat / duration },
        { transform: 'scale(1.32) rotate(0deg)', offset: 5 * shakeBeat / duration },
        { transform: 'scale(1) rotate(0deg)', offset: 1 },
      ], { duration, easing: 'ease-in-out' });
      entranceObserver?.disconnect();
    }, { threshold: 1 });
    entranceObserver.observe(remixButton);
  }
  cueRemix();
  window.addEventListener('pageshow', event => {
    if (event.persisted) cueRemix();
  });

  function animateToken(button: Element) {
    button.classList.remove('is-playing');
    requestAnimationFrame(() => requestAnimationFrame(() => button.classList.add('is-playing')));
  }
  play?.querySelectorAll('.personal-token').forEach(button => {
    button.addEventListener('click', () => animateToken(button));
    button.addEventListener('animationend', () => button.classList.remove('is-playing'));
  });
  function remix(animate = false) {
    play?.querySelectorAll('ul').forEach(list => {
      const items = Array.from(list.children) as HTMLLIElement[];
      const previous = new Set(items.filter(item => !item.hidden));
      for (let i = items.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [items[i], items[j]] = [items[j], items[i]];
      }
      // Ensure each click reveals at least one different option in every category.
      if (items.length > 3 && items.slice(0, 3).every(item => previous.has(item))) {
        const replacement = 3 + Math.floor(Math.random() * (items.length - 3));
        const slot = Math.floor(Math.random() * 3);
        [items[slot], items[replacement]] = [items[replacement], items[slot]];
      }
      items.forEach((item, index) => {
        item.getAnimations().forEach(animation => animation.cancel());
        item.hidden = index >= 3;
        list.append(item);
        const button = item.querySelector('button');
        if (animate && index < 3 && button) {
          animateToken(button);
          if (!reducedMotion.matches) item.animate([
            { opacity: 0, transform: 'translateX(18px)' },
            { opacity: 1, transform: 'translateX(0)' },
          ], { duration: 320, delay: index * 55, fill: 'backwards', easing: 'cubic-bezier(.22,1,.36,1)' });
        }
      });
    });
  }
  remix();
  play?.querySelector('.personal-remix')?.addEventListener('click', () => {
    remix(true);
    const status = play.querySelector('.personal-remix-status');
    if (status) status.textContent = Array.from(play.querySelectorAll('.personal-play-group')).map(group => {
      const heading = group.querySelector('h3')?.textContent;
      const labels = Array.from(group.querySelectorAll('li:not([hidden]) .personal-token>span')).map(item => item.textContent);
      return `${heading}: ${labels.join(', ')}.`;
    }).join(' ');
  });
</script>
