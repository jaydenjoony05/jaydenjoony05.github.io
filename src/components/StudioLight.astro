<div class="studio-light" aria-hidden="true">
  <svg viewBox="0 0 1400 950" preserveAspectRatio="none" focusable="false">
    <defs>
      <filter id="studio-soft-shadow" x="-30%" y="-30%" width="160%" height="160%">
        <feGaussianBlur stdDeviation="13"/>
      </filter>
    </defs>
    <g class="window-shadow" fill="none" stroke="#48566a" stroke-width="32" filter="url(#studio-soft-shadow)">
      <path d="M240 -230 650 1110M650 -230 1060 1110M1060 -230 1470 1110M-200 90 1600 -100M-200 430 1600 240M-200 770 1600 580"/>
    </g>
  </svg>
</div>
<style>
  :global(.sidebar-home .hero){position:relative}
  .studio-light{position:absolute;inset:0 calc(-1 * var(--light-bleed,30px));z-index:6;pointer-events:none;overflow:hidden;mix-blend-mode:multiply;opacity:calc(.26 * var(--light-intensity,.5));mask-image:linear-gradient(to bottom,#000 0%,#000 35%,rgba(0,0,0,.45) 65%,transparent 96%)}
  svg{display:block;width:calc(100% + 120px);height:calc(100% + 80px);margin:-40px -60px;pointer-events:none;transform:translate(var(--light-x,0px),var(--light-y,0px));transition:transform .85s cubic-bezier(.22,1,.36,1)}
  .window-shadow{transform-origin:50% 20%;animation:studio-light-drift 28s ease-in-out infinite alternate}
  @keyframes studio-light-drift{from{transform:translate(-12px,-6px) rotate(-1deg)}to{transform:translate(22px,10px) rotate(1.5deg)}}
  @media(max-width:700px){.studio-light{opacity:calc(.18 * var(--light-intensity,.5))}}
  @media(prefers-reduced-motion:reduce){.window-shadow{animation:none}svg{transform:none;transition:none}}
</style>

<script>
const light=document.querySelector<HTMLElement>('.studio-light');
const hero=light?.closest<HTMLElement>('.hero');
const responsive=matchMedia('(hover:hover) and (pointer:fine) and (prefers-reduced-motion:no-preference)');
if(light&&hero){
  const control=hero.querySelector<HTMLInputElement>('.light-control input');
  const updateLight=()=>{
    if(!control) return;
    const value=Number(control.value);
    light.style.setProperty('--light-intensity',String(value/100));
    control.parentElement!.style.setProperty('--level',`${value}%`);
    control.setAttribute('aria-valuetext',value===0?'Shadows off':`${value} percent`);
  };
  control?.addEventListener('input',updateLight);
  updateLight();
  const panel=hero.parentElement!;
  const fit=()=>light.style.setProperty('--light-bleed',`${Math.max(0,(panel.clientWidth-hero.offsetWidth)/2)}px`);
  fit();
  const bounds=new ResizeObserver(fit);
  bounds.observe(panel);
  bounds.observe(hero);
  let frame=0;
  let x=0,y=0;
  const paint=()=>{
    frame=0;
    light.style.setProperty('--light-x',`${x}px`);
    light.style.setProperty('--light-y',`${y}px`);
  };
  const queue=()=>{if(!frame) frame=requestAnimationFrame(paint);};
  const reset=()=>{x=0;y=0;queue();};
  hero.addEventListener('pointermove',event=>{
    if(!responsive.matches||event.pointerType!=='mouse') return;
    const rect=hero.getBoundingClientRect();
    // A small opposing shift suggests depth, without moving the artwork.
    x=(.5-Math.max(0,Math.min(1,(event.clientX-rect.left)/rect.width)))*28;
    y=(.5-Math.max(0,Math.min(1,(event.clientY-rect.top)/rect.height)))*20;
    queue();
  },{passive:true});
  hero.addEventListener('pointerleave',reset);
  hero.addEventListener('pointercancel',reset);
  responsive.addEventListener('change',reset);
  window.addEventListener('blur',reset);
}
</script>
