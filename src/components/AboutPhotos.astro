---
const photos = [
  { name: 'desert', alt: 'Friends beside camels in the desert', width: 1200, height: 804 },
  { name: 'portrait', alt: 'Jayden sitting at a café surrounded by plants', width: 1200, height: 1600 },
  { name: 'golf', alt: 'A golf swing on a sunny green course', width: 717, height: 1000 },
  { name: 'gallery', alt: 'Looking at a shark sculpture in a turquoise gallery tank', width: 750, height: 1000 },
  { name: 'mirror', alt: 'A mirror photo in a wood-paneled elevator', width: 750, height: 1000 },
  { name: 'running', alt: 'A selfie during a sunny outdoor run', width: 750, height: 1000 },
  { name: 'dinner', alt: 'Three friends sharing an evening meal', width: 800, height: 600 },
  { name: 'lakeside', alt: 'Friends relaxing on the rocks beside the lake', width: 1000, height: 750 },
  { name: 'london', alt: 'Friends beside the river with the London Eye behind them', width: 800, height: 600 },
];
---
<div class="about-photos" role="group" aria-label="A few moments outside the studio">
  {photos.map(({ name, alt, width, height }) => (
    <img class={`about-photo about-photo-${name}`} src={`/images/about/${name}.webp`} alt={alt} width={width} height={height} loading={name === 'portrait' ? 'eager' : 'lazy'} />
  ))}
</div>

<script>
  import { markAboutPhotosFinished } from '../scripts/about-motion';
  const photos = document.querySelector('.about-photos');
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (photos && !motion.matches) {
    const observer = new IntersectionObserver(async entries => {
      if (!entries.some(entry => entry.isIntersecting)) return;
      observer.disconnect();
      const animations = !motion.matches ? Array.from(photos.querySelectorAll('img'), (photo, index) => {
        return photo.animate([
          { opacity: 0, transform: 'translateY(16px) scale(.98)' },
          { opacity: 1, transform: 'translateY(0) scale(1)' },
        ], { duration: 420, delay: index * 55, fill: 'backwards', easing: 'cubic-bezier(.22,1,.36,1)' });
      }) : [];
      await Promise.allSettled(animations.map(animation => animation.finished));
      markAboutPhotosFinished();
    }, { threshold: .12 });
    observer.observe(photos);
  } else {
    markAboutPhotosFinished();
  }
</script>
