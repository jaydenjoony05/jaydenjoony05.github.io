---
import dimensions from '../data/image-dimensions.json';
const { image, alt, eager=false, sizes='(max-width: 700px) 100vw, 50vw' }=Astro.props;
const name=image.file.split('~')[0];
const [width,height]=(dimensions as Record<string,number[]>)[name]||[1600,1200];
---
<img width={width} height={height} src={`/images/${name}-1600.webp`} srcset={`/images/${name}-600.webp 600w, /images/${name}-1600.webp 1600w`} sizes={sizes} alt={alt || image.alt || 'Artwork by Jayden Park'} loading={eager?'eager':'lazy'} decoding="async" />
