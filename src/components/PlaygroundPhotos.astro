---
const photos = [
  {name:'atrium',alt:'Friends together in a bright campus atrium'},
  {name:'group-dinner',alt:'Friends sharing dinner around a restaurant table'},
  {name:'friends',alt:'Three friends making hand gestures for a photo'},
  {name:'vaps',alt:'Friends at the VAPS student organization table'},
  {name:'festival',alt:'A playful moment with Korean flags at an outdoor gathering'},
];
---
<div class="playground-photos" role="group" aria-label="Friends and moments behind the graphics">
  {photos.map(p=><figure class={`snapshot snapshot-${p.name}`}><img src={`/images/playground/${p.name}.webp`} alt={p.alt} loading="eager" decoding="async"/></figure>)}
</div>
<style>
.playground-photos{position:relative;width:100%;aspect-ratio:1.04;max-width:620px;justify-self:center}
.snapshot{position:absolute;margin:0;padding:6px 6px 15px;background:#fffefa;border:1px solid #1d355716;box-shadow:0 5px 16px #1d355714;transform:rotate(var(--tilt));transition:transform .25s,box-shadow .25s}
.snapshot img{width:100%;height:100%;object-fit:cover}
.snapshot-atrium{left:2%;top:3%;width:40%;height:49%;--tilt:-5deg;z-index:2}.snapshot-atrium img{object-position:50% 90%}
.snapshot-group-dinner{right:0;top:1%;width:54%;height:34%;--tilt:4deg;z-index:1}.snapshot-group-dinner img{object-position:50% 60%}
.snapshot-friends{left:26%;top:34%;width:40%;height:32%;--tilt:-3deg;z-index:4}
.snapshot-vaps{left:0;bottom:1%;width:54%;height:37%;--tilt:3deg;z-index:3}.snapshot-vaps img{object-position:50% 85%}
.snapshot-festival{right:0;bottom:0;width:35%;height:55%;--tilt:5deg;z-index:2}.snapshot-festival img{object-position:60% 80%}
@media(hover:hover){.snapshot:hover{transform:rotate(0) scale(1.035);z-index:5;box-shadow:0 9px 24px #1d355722}}
@media(max-width:600px){.snapshot{padding:4px 4px 10px}}
@media(prefers-reduced-motion:reduce){.snapshot{transition:none}}
</style>
