---
import Picture from './Picture.astro';
import projects from '../data/projects.json';
const opening=['the-upside-downtown','pepper','textures','change-miracle-flights','drift','voyage','under-construction','change-design-challenge','book-cover-design','labrador','moma-virtual-tours','milk-packaging-design','oblivious','jersey-design','rideshield','food-courier','dream','perfume-poster-design','dunkin-poster-design','card-design','indpnt-studio'];
const retainedShapes: Record<string, number> = {'dream':4,'food-courier':5,'perfume-poster-design':3};
const ordered=[...opening.map(slug=>projects.find(p=>p.slug===slug)!),...projects.filter(p=>!opening.includes(p.slug))];
---
<section class="fragment-section wrap" id="creative-work" aria-labelledby="fragments-title">
  <div class="section-heading fragment-heading">
    <div><p class="eyebrow">02 / Selected fragments</p><h2 id="fragments-title">A <span class="fragment-little">little</span> bit<br/>of <strong>everything</strong>.</h2></div>
    <div class="fragment-introduction"><p>Fine Art, pixels, and in-between ideas.<br/> Follow whatever catches your eye.</p><div class="fragment-credit"><p>Featured on:</p><ul><li><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2v20M2 12h20M5 5l14 14M5 19 19 5" fill="none" stroke="currentColor" stroke-width="2.4"/></svg><em>Vanderbilt Review</em></li><li><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 2v20M2 12h20M5 5l14 14M5 19 19 5" fill="none" stroke="currentColor" stroke-width="2.4"/></svg><em>The Scholastic Art &amp; Writing Awards</em></li></ul></div></div>
  </div>
  <div class="fragment-toolbar">
    <div class="filters" aria-label="Filter creative projects"><button data-filter="all" aria-pressed="true">All fragments</button><button data-filter="art" aria-pressed="false">Fine Art</button><button data-filter="design" aria-pressed="false">Design</button></div>
    <span class="fragment-count" data-filter-status aria-live="polite">{ordered.length} fragments</span>
  </div>
  <div class="fragment-web" data-active-filter="all">
    {ordered.map((project,i)=><article class={`fragment fragment-shape-${retainedShapes[project.slug] ?? i%6}`} data-kind={project.kind} data-project={project.slug}>
      <a class="fragment-link" href={`/work/${project.slug}/`}>
        <div class:list={['fragment-image',project.kind]}>
          {project.slug==='pepper' ? <div class="pepper-fragment-preview">
            <img class="pepper-preview-logo" src="/images/pepper-logo.png" width="280" height="136" alt="Pepper" loading="lazy"/>
            <div class="pepper-preview-pages">{[1,2,0,3].map(index=><div class="pepper-preview-screen"><Picture image={project.images[index]} alt={project.images[index].alt} sizes="(max-width: 550px) 18vw, 8vw"/></div>)}</div>
          </div> : <Picture image={project.slug==='the-upside-downtown'?{file:'183f58_26b25dce1a5f4730950c4d074159297b~mv2.jpg'}:project.images[0]} alt={`${project.title} — ${project.category}`} sizes="(max-width: 550px) 90vw, (max-width: 900px) 44vw, 38vw"/>}
          <span class="fragment-open" aria-hidden="true">View fragment ↗</span>
        </div>
        <div class="fragment-label"><div><h3>{project.title}</h3><p>{project.category}</p></div><span class="fragment-arrow" aria-hidden="true">↗</span></div>
      </a>
    </article>)}
  </div>
</section>

<style>
  @media(min-width:901px){
    .fragment-web[data-active-filter="all"] .fragment:nth-child(-n+3){align-self:end;padding-top:0}
  }
  @media(min-width:901px){
    .fragment-web[data-active-filter="all"] .fragment[data-project="indpnt-studio"]{grid-column:4 / span 6;width:100%;justify-self:center;padding-top:30px}
  }
  @media(min-width:551px) and (max-width:900px){
    .fragment-web[data-active-filter="all"] .fragment[data-project="indpnt-studio"]{grid-column:1 / -1;width:65%;justify-self:center;padding-top:20px}
  }
  @media(max-width:550px){
    .fragment-web[data-active-filter="all"] .fragment[data-project="indpnt-studio"]{width:100%;justify-self:center}
  }
  .fragment[data-project="pepper"] .fragment-image{min-height:0;padding:8px 0}
  .pepper-fragment-preview{display:flex;flex-direction:column;align-items:center;gap:9.6px;width:80%;margin-inline:auto;transition:transform .3s ease}
  .pepper-fragment-preview .pepper-preview-logo{width:76%;max-width:240px;height:auto;max-height:none;object-fit:contain}
  .pepper-preview-pages{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(4px,.6vw,8px);width:100%;align-items:center}
  .pepper-preview-screen{overflow:hidden;border:1px solid var(--line);aspect-ratio:780/1688}
  .pepper-preview-screen :global(img){width:100%;height:100%;max-height:none;object-fit:cover}
  .pepper-preview-screen:last-child :global(img){scale:1.012}
  @media(min-width:901px){
    .fragment-web[data-active-filter="all"] .pepper-fragment-preview{position:relative;top:clamp(-50px,-3.5vw,-32px)}
  }
  @media(hover:hover){.fragment-link:hover .pepper-fragment-preview{transform:translateY(-7px) scale(1.025)}.fragment-link:hover .pepper-fragment-preview :global(img){transform:none}}
</style>

<script>
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const cards = document.querySelectorAll('.fragment-link');
  if (!motion.matches && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('fragment-revealed');
        observer.unobserve(entry.target);
      });
    }, { threshold: 0 });
    cards.forEach(card => {
      observer.observe(card);
      card.addEventListener('focus', () => {
        card.classList.add('fragment-revealed');
        observer.unobserve(card);
      });
    });
    motion.addEventListener('change', event => {
      if (event.matches) {
        observer.disconnect();
        cards.forEach(card => card.classList.add('fragment-revealed'));
      }
    });
  }
</script>
